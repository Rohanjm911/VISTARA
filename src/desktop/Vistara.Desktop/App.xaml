<Application x:Class="Vistara.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             Exit="Application_Exit">
    <Application.Resources>
         <SolidColorBrush x:Key="DarkBg" Color="#06070a"/>
         <SolidColorBrush x:Key="PanelBg" Color="#0e1017"/>
         <SolidColorBrush x:Key="TitleBarBg" Color="#0e1017"/>
         <SolidColorBrush x:Key="BorderColor" Color="#2a303c"/>
         <SolidColorBrush x:Key="AccentColor" Color="#7c3aed"/>
         <SolidColorBrush x:Key="TextPrimary" Color="#f3f4f6"/>
         <SolidColorBrush x:Key="TextSecondary" Color="#9ca3af"/>
    </Application.Resources>
</Application>

